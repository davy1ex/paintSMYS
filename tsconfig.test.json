{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": [
    "src/application/**/*.ts",
    "src/core/**/*.ts",
    "src/app/desktop/window/close-handshake.ts",
    "src/app/desktop/plugins/isolated-plugin-runtime.ts",
    "src/app/desktop/project-storage.ts",
    "src/app/desktop/plugin-loader.ts",
    "src/app/desktop/png-export.ts",
    "src/editor/workspace/rectangle-geometry.ts",
    "src/editor/workspace/viewport-math.ts",
    "src/editor/workspace/SceneSvgContent.tsx",
    "src/editor/workspace/scene-svg-serialization.tsx",
    "tests/**/*.ts"
  ],
  "exclude": ["tests/e2e/**", "tests/desktop-e2e/**"]
}
